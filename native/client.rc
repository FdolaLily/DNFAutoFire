206 RCDATA "fonts/JetBrainsMono-SemiBold.ttf"
207 RCDATA "fonts/JetBrainsMono-Bold.ttf"
1 VERSIONINFO
FILEVERSION 0,1,6,0
PRODUCTVERSION 0,1,6,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404B0"
  BEGIN
   VALUE "CompanyName", "DNFAutoFire project\0"
   VALUE "FileDescription", "DNF 连发工具 - 原生 Windows 客户端\0"
   VALUE "FileVersion", "0.1.6.0\0"
